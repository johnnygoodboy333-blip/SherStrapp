<Window x:Class="SherStrapp.UI.Elements.Overlay.GameOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SherStrapp.UI.ViewModels.Overlay"
        xmlns:conv="clr-namespace:SherStrapp.UI.Converters"
        Title="SherStrapp Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolVis"/>

        <!-- Media control button -->
        <Style x:Key="MediaBtn" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="19"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play/pause primary button — slightly larger -->
        <Style x:Key="MediaBtnPrimary" TargetType="Button" BasedOn="{StaticResource MediaBtn}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>

        <!-- Icon-style close button -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:GameOverlayViewModel/>
    </Window.DataContext>

    <Grid>
        <!-- Full-screen scrim — click to dismiss -->
        <Rectangle Fill="#77000000" MouseLeftButtonDown="Scrim_Click"/>

        <!-- ── Side panel ──────────────────────────────────────────────────── -->
        <Border Width="340"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="#E8111318"
                BorderBrush="#28FFFFFF"
                BorderThickness="0,0,1,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.7"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,20,20,24">

                    <!-- ── Header ───────────────────────────────────────────── -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SherStrapp"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="White"
                                       FontFamily="Segoe UI"/>
                            <TextBlock Text="In-Game Overlay"
                                       FontSize="10"
                                       Foreground="#66FFFFFF"
                                       FontFamily="Segoe UI"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CloseCommand}"
                                Content="✕"
                                Style="{StaticResource CloseBtn}"
                                ToolTip="Close (Ctrl+Alt+X)"/>
                    </Grid>

                    <Rectangle Fill="#22FFFFFF" Height="1" Margin="0,14,0,16"/>

                    <!-- ── Clock ─────────────────────────────────────────────── -->
                    <Border Background="#18FFFFFF" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="CLOCK"
                                       FontSize="9" FontWeight="Bold" LetterSpacing="1.5"
                                       Foreground="#55FFFFFF" FontFamily="Segoe UI"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ClockTime}"
                                       FontSize="30" FontWeight="Light"
                                       Foreground="White" FontFamily="Segoe UI Light"/>
                            <TextBlock Text="{Binding ClockDate}"
                                       FontSize="12" Foreground="#88FFFFFF"
                                       FontFamily="Segoe UI" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Roblox session (only shown when Roblox is running) ── -->
                    <Border Background="#18FFFFFF" CornerRadius="10" Padding="16,14" Margin="0,0,0,10"
                            Visibility="{Binding RobloxRunning, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="SESSION"
                                       FontSize="9" FontWeight="Bold" LetterSpacing="1.5"
                                       Foreground="#55FFFFFF" FontFamily="Segoe UI"
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#44DD88"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Roblox Active"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#44DD88" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RobloxInfo}"
                                       FontSize="11" Foreground="#77FFFFFF"
                                       FontFamily="Segoe UI" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Media player ──────────────────────────────────────── -->
                    <Border Background="#18FFFFFF" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="NOW PLAYING"
                                       FontSize="9" FontWeight="Bold" LetterSpacing="1.5"
                                       Foreground="#55FFFFFF" FontFamily="Segoe UI"
                                       Margin="0,0,0,10"/>

                            <!-- Album art + track info row -->
                            <Grid Margin="0,0,0,14"
                                  Visibility="{Binding HasMedia, Converter={StaticResource BoolVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Album art -->
                                <Border Width="56" Height="56" CornerRadius="8"
                                        Background="#22FFFFFF" ClipToBounds="True"
                                        Margin="0,0,12,0">
                                    <Image Source="{Binding AlbumArt}" Stretch="UniformToFill"/>
                                </Border>

                                <!-- Track + artist -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TrackTitle}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="White" FontFamily="Segoe UI"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding TrackArtist}"
                                               FontSize="11" Foreground="#77FFFFFF"
                                               FontFamily="Segoe UI"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- No media hint -->
                            <TextBlock Text="Play something in Spotify, YouTube Music, or any media app"
                                       FontSize="11" Foreground="#55FFFFFF"
                                       FontFamily="Segoe UI" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,0,0,12"
                                       Visibility="{Binding HasMedia, Converter={StaticResource InvBoolVis}}"/>

                            <!-- Controls -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        IsEnabled="{Binding HasMedia}">
                                <Button Command="{Binding PrevCommand}"    Content="⏮" Style="{StaticResource MediaBtn}"/>
                                <Button Command="{Binding PlayPauseCommand}" Content="{Binding PlayPauseGlyph}" Style="{StaticResource MediaBtnPrimary}" Margin="8,0"/>
                                <Button Command="{Binding NextCommand}"    Content="⏭" Style="{StaticResource MediaBtn}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Discord ────────────────────────────────────────────── -->
                    <Border Background="#18FFFFFF" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="DISCORD"
                                       FontSize="9" FontWeight="Bold" LetterSpacing="1.5"
                                       Foreground="#55FFFFFF" FontFamily="Segoe UI"
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#555555"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiscordRunning}" Value="True">
                                                    <Setter Property="Fill" Value="#5865F2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding DiscordStatus}"
                                           FontSize="12" Foreground="#CCFFFFFF"
                                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Friends list integration coming soon"
                                       FontSize="10" Foreground="#44FFFFFF"
                                       FontFamily="Segoe UI" Margin="0,8,0,0"
                                       Visibility="{Binding DiscordRunning, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Hotkey hint ─────────────────────────────────────────── -->
                    <TextBlock Text="Ctrl + Alt + X to toggle"
                               FontSize="10" Foreground="#2AFFFFFF"
                               FontFamily="Segoe UI" HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
