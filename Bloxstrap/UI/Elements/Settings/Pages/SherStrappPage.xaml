<ui:UiPage x:Class="SherStrapp.UI.Elements.Settings.Pages.SherStrappPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:SherStrapp.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      Title="SherStrappPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">

        <!-- Header -->
        <TextBlock Text="SherStrapp Settings" FontSize="14"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,8" />

        <!-- ── Custom Profile Picture ──────────────────────────────────── -->
        <TextBlock Text="Custom Profile Picture" FontSize="20" FontWeight="Medium" Margin="0,8,0,4" />

        <ui:Card Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Preview -->
                <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="2" ClipToBounds="True">
                    <Image Source="{Binding ProfilePicturePreview, Mode=OneWay}"
                           Stretch="UniformToFill">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProfilePicture}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <!-- Placeholder icon -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CustomProfilePicturePath, Mode=OneWay}"
                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Icon="ImageAdd24" Content="Browse"
                                   Command="{Binding BrowseProfilePictureCommand}"
                                   Margin="0,0,8,0" />
                        <ui:Button Icon="Dismiss24" Content="Clear"
                                   Command="{Binding ClearProfilePictureCommand}"
                                   Appearance="Secondary"
                                   IsEnabled="{Binding HasProfilePicture, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="PNG, JPG or BMP recommended. Displayed in settings and optionally in Discord RPC."
                               FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <controls:OptionControl Header="Use custom picture in Discord RPC"
                                Description="Replaces the Roblox avatar headshot with your custom image in rich presence">
            <ui:ToggleSwitch IsChecked="{Binding UseCustomProfilePictureInRPC, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- ── Accent Colour ───────────────────────────────────────────── -->
        <TextBlock Text="Accent Colour" FontSize="20" FontWeight="Medium" Margin="0,16,0,4" />

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Hex value" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Width="80" />
                    <ui:TextBox Width="120" Text="{Binding AccentColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Border Width="32" Height="32" Margin="8,0,0,0" CornerRadius="4"
                            Background="{Binding AccentColorPreview, Mode=OneWay}"
                            BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                </StackPanel>

                <TextBlock Text="Presets" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Silver"  Command="{Binding SetAccentSilverCommand}"  Margin="0,0,6,0" />
                    <ui:Button Content="White"   Command="{Binding SetAccentWhiteCommand}"   Margin="0,0,6,0" />
                    <ui:Button Content="Gold"    Command="{Binding SetAccentGoldCommand}"    Margin="0,0,6,0" />
                    <ui:Button Content="Cyan"    Command="{Binding SetAccentCyanCommand}"    Margin="0,0,6,0" />
                    <ui:Button Content="Purple"  Command="{Binding SetAccentPurpleCommand}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- ── Bootstrapper Logo ──────────────────────────────────────── -->
        <TextBlock Text="Loading Dialog" FontSize="20" FontWeight="Medium" Margin="0,16,0,4" />

        <controls:OptionControl Header="Use SherStrapp star logo"
                                Description="Shows the SherStrapp star logo in the loading dialog instead of the Roblox logo">
            <ui:ToggleSwitch IsChecked="{Binding UseCustomBootstrapperLogo, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- ── About ──────────────────────────────────────────────────── -->
        <TextBlock Text="About" FontSize="20" FontWeight="Medium" Margin="0,16,0,4" />

        <ui:Card>
            <StackPanel>
                <TextBlock Text="{Binding VersionString, Mode=OneTime}"
                           FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding BuildInfo, Mode=OneTime}"
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,2,0,0" />
                <TextBlock Text="Built on Bloxstrap — MIT licensed"
                           FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,6,0,0" />
            </StackPanel>
        </ui:Card>

    </StackPanel>
</ui:UiPage>
