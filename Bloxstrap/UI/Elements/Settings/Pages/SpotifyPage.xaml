<ui:UiPage x:Class="SherStrapp.UI.Elements.Settings.Pages.SpotifyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:dmodels="clr-namespace:SherStrapp.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:SpotifyViewModel, IsDesignTimeCreatable=False}"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="SpotifyPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">

        <TextBlock Text="Now Playing" FontSize="14"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

        <!-- ── Now Playing card ──────────────────────────────────────────── -->
        <ui:Card Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Album art -->
                <Border Grid.Column="0" Width="80" Height="80" CornerRadius="8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        ClipToBounds="True">
                    <Image Source="{Binding AlbumArt, Mode=OneWay}" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NowPlayingText, Mode=OneWay}"
                               FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ArtistText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"/>

                    <!-- Controls -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Icon="Previous24" Command="{Binding PrevCommand}"
                                   IsEnabled="{Binding HasSession, Mode=OneWay}"
                                   Margin="0,0,6,0" Padding="8,4"/>
                        <ui:Button Icon="{Binding PlayPauseIcon, Mode=OneWay}"
                                   Command="{Binding PlayPauseCommand}"
                                   IsEnabled="{Binding HasSession, Mode=OneWay}"
                                   Margin="0,0,6,0" Padding="8,4"/>
                        <ui:Button Icon="Next24" Command="{Binding NextCommand}"
                                   IsEnabled="{Binding HasSession, Mode=OneWay}"
                                   Padding="8,4"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- ── Info card ──────────────────────────────────────────────────── -->
        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="No login required"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{Binding StatusNote, Mode=OneTime}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" FontSize="13"/>
            </StackPanel>
        </ui:Card>

    </StackPanel>
</ui:UiPage>
